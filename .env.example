# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here

# File Paths
CAT_IMAGES_FOLDER=cat_images
DATA_DB=sprytek.sqlite

# Long Kitten Nation (leave LKN_BOT_SECRET empty to switch it off)
LKN_URL=http://127.0.0.1:3100
LKN_BOT_SECRET=
LKN_GUILD_ID=
LKN_ROLE_ID=
LKN_CHANNEL_ID=

# Seasons Clicker leaderboard on mattkrupa.net (leave CLICKER_BOT_SECRET empty to switch it off)
# The same secret as CLICKER_BOT_SECRET of the mattnet Worker (Cloudflare: Settings > Variables and Secrets)
CLICKER_URL=https://mattkrupa.net
CLICKER_BOT_SECRET=
# #sc-scores; the server is LKN_GUILD_ID unless CLICKER_GUILD_ID is set
CLICKER_CHANNEL_ID=
