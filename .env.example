# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Server Whitelist (comma-separated guild IDs, leave empty to allow all)
ALLOWED_GUILDS=123456789,987654321

# File Paths
CAT_IMAGES_FOLDER=cat_images
MUSIC_FOLDER=music
USERS_DATA_FILE=users_data.json

# Bot Settings (in seconds)
SPAM_COOLDOWN=3
MUSIC_BREAK=5